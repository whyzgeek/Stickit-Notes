#!/usr/bin/env python3
"""Launcher used by the plugin's hooks and skills: runs stickit from this checkout."""
import os
import runpy
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))
sys.argv[0] = "stickit"
runpy.run_module("stickit", run_name="__main__", alter_sys=True)
